<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="LaporanBulananDataSet"
           targetNamespace="http://tempuri.org/LaporanBulananDataSet.xsd"
           xmlns:mstns="http://tempuri.org/LaporanBulananDataSet.xsd"
           xmlns="http://tempuri.org/LaporanBulananDataSet.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           attributeFormDefault="qualified"
           elementFormDefault="qualified">
  <xs:element name="LaporanBulananDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="LaporanBulanan">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Date" type="xs:dateTime" minOccurs="0" />
              <xs:element name="Description" type="xs:string" minOccurs="0" />
              <xs:element name="Kategori" type="xs:string" minOccurs="0" />
              <xs:element name="Amount" type="xs:decimal" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>
